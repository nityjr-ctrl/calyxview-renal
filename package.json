{
  "name": "calyxview-renal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.netlify.config.ts",
    "build": "vite build --config vite.netlify.config.ts",
    "build:netlify": "npm run test && npm run lint && npm run typecheck && npm run build && npm run scan:bundle",
    "preview": "vite preview --config vite.netlify.config.ts",
    "lint": "oxlint components lib src vite.netlify.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/benchmark-results.test.mjs test/benchmark-results-contract.test.mjs",
    "scan:bundle": "node test/deploy-bundle-scan.mjs",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "type": "module"
}
